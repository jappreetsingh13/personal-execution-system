{
  "expo": {
    "name": "Todos",
    "slug": "todos",
    "scheme": "todos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.jappreet.todos",
      "adaptiveIcon": {
        "backgroundColor": "#A855F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jappreet.todos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm_classic.wav",
            "./assets/sounds/alarm_pulse.wav",
            "./assets/sounds/notify_chime.wav",
            "./assets/sounds/notify_ping.wav"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2324ea3-976f-4f17-bd26-9329a7492743"
      }
    },
    "owner": "jappreetsingh13"
  }
}
