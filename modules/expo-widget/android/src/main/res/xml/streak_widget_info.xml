<?xml version="1.0" encoding="utf-8"?>
<!-- Sized as a 2x2 widget, horizontally resizable only to 3x2 (resizeMode is
     horizontal, so the height always stays two rows). updatePeriodMillis
     cannot go below 30 minutes; the affirmation itself is bucketed to 4-hour
     slots inside the provider, so a 30-minute refresh is enough for it to
     turn over on schedule. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="180dp"
    android:maxResizeHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/streak_widget"
    android:previewLayout="@layout/streak_widget"
    android:resizeMode="horizontal"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
